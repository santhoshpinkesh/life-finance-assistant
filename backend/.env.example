# CRITICAL: Set these for production deployment
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-in-production

# Database URL - MUST be Postgres in production (ephemeral SQLite will lose data)
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///./life_finance.db

# Frontend URL for CORS - set to actual domain in production
FRONTEND_ORIGIN=*

# Environment flag for warnings
ENVIRONMENT=development
